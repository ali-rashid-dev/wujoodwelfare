generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  accounts      Account[]
  sessions      Session[]
  staff         Staff?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BeneficiaryStatus {
  PENDING
  VERIFIED
  ACTIVE
  INACTIVE
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  INITIAL_REVIEW
  VERIFICATION
  ELIGIBILITY_ASSESSMENT
  APPROVED
  REJECTED
}

enum ApplicationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssistanceType {
  FOOD
  MEDICAL
  EDUCATION
  FINANCIAL
  HOUSING
  CLOTHING
  ORPHAN_SUPPORT
  DISABILITY_SUPPORT
  EMERGENCY_RELIEF
  MARRIAGE_ASSISTANCE
  EMPLOYMENT_SUPPORT
  MONTHLY_FINANCIAL_AID
  OTHER
}

enum DocumentType {
  CNIC
  B_FORM
  PROOF_OF_INCOME
  PROOF_OF_RESIDENCE
  MEDICAL_REPORT
  ORPHAN_CERTIFICATE
  DISABILITY_CERTIFICATE
  MARRIAGE_CERTIFICATE
  JOB_APPLICATION
  ACADEMIC_RECORD
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
  DAILY_WAGE
  RETIRED
  DISABLED
  STUDENT
}

enum HousingType {
  OWNED
  RENTED
  SHARED
  HOMELESS
}

// ─── Beneficiary Models ────────────────────────────────────────────────────────

model Beneficiary {
  id           String            @id @default(cuid())
  cnic         String?           @unique
  name         String
  fatherName   String?
  dateOfBirth  DateTime?
  gender       Gender?
  religion     String?
  education    String?
  status       BeneficiaryStatus @default(PENDING)
  notes        String?
  verifiedAt   DateTime?
  registeredAt DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  phone    String?
  whatsapp String?
  email    String?

  address           BeneficiaryAddress?
  family            BeneficiaryFamily?
  economic          BeneficiaryEconomic?
  documents         BeneficiaryDocument[]
  cases             BeneficiaryCase[]
  assistanceHistory AssistanceRecord[]
  programEnrollments ProgramEnrollment[]
  applications      WelfareApplication[]

  householdId          String?
  household            Household?        @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
  headOfHouseholds     Household[]       @relation("HouseholdHead")
  householdMemberItems HouseholdMember[]

  @@map("beneficiary")
}

model BeneficiaryAddress {
  id            String      @id @default(cuid())
  beneficiaryId String      @unique
  street        String?
  area          String?
  city          String?
  district      String?
  province      String?
  postalCode    String?
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_address")
}

model BeneficiaryFamily {
  id              String         @id @default(cuid())
  beneficiaryId   String         @unique
  maritalStatus   MaritalStatus?
  spouseName      String?
  totalChildren   Int            @default(0)
  maleChildren    Int            @default(0)
  femaleChildren  Int            @default(0)
  dependents      Int            @default(0)
  disabledMembers Int            @default(0)
  beneficiary     Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_family")
}

model BeneficiaryEconomic {
  id               String            @id @default(cuid())
  beneficiaryId    String            @unique
  employmentStatus EmploymentStatus?
  occupation       String?
  monthlyIncome    Decimal?          @db.Decimal(12, 2)
  housingType      HousingType?
  ownLand          Boolean           @default(false)
  bankAccount      Boolean           @default(false)
  beneficiary      Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_economic")
}

model BeneficiaryDocument {
  id            String       @id @default(cuid())
  beneficiaryId String
  type          DocumentType
  label         String?
  fileUrl       String
  uploadedAt    DateTime     @default(now())
  beneficiary   Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_document")
}

model BeneficiaryCase {
  id            String           @id @default(cuid())
  beneficiaryId String
  title         String
  description   String?
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  isOpen        Boolean          @default(true)
  beneficiary   Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  assignments   CaseAssignment[]

  @@map("beneficiary_case")
}

model AssistanceRecord {
  id            String          @id @default(cuid())
  beneficiaryId String
  programId     String?
  program       WelfareProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  type          AssistanceType
  description   String?
  amount        Decimal?        @db.Decimal(12, 2)
  quantity      String?
  givenAt       DateTime        @default(now())
  givenBy       String?
  beneficiary   Beneficiary     @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("assistance_record")
}

// ─── Household Models ─────────────────────────────────────────────────────────

model Household {
  id                String       @id @default(cuid())
  householdCode     String       @unique
  name              String
  headBeneficiaryId String?
  headBeneficiary   Beneficiary? @relation("HouseholdHead", fields: [headBeneficiaryId], references: [id], onDelete: SetNull)

  fixedMonthlyIncome Decimal? @db.Decimal(12, 2)
  monthlyIncome      Decimal? @db.Decimal(12, 2)
  totalMembers       Int      @default(1)
  dependents         Int      @default(0)
  elderlyCount       Int      @default(0)
  disabledCount      Int      @default(0)
  childrenCount      Int      @default(0)

  housingType           HousingType?
  housingCondition      String?
  vulnerabilityScore    Int          @default(0)
  vulnerabilityCategory String       @default("MODERATE")
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries Beneficiary[]       @relation("HouseholdMembers")
  members       HouseholdMember[]
  documents     HouseholdDocument[]

  @@map("household")
}

model HouseholdCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("household_code_sequence")
}

model HouseholdMember {
  id            String       @id @default(cuid())
  householdId   String
  household     Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  fullName         String
  cnic             String?
  relationToHead   String
  age              Int?
  gender           Gender?
  employmentStatus EmploymentStatus?
  monthlyIncome    Decimal?          @db.Decimal(12, 2)
  isDisable        Boolean           @default(false)
  isElderly        Boolean           @default(false)
  isDependent      Boolean           @default(true)
  healthCondition  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("household_member")
}

model HouseholdDocument {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  type        DocumentType
  fileUrl     String
  uploadedAt  DateTime     @default(now())

  @@map("household_document")
}

// ─── Staff & Volunteer Enums ──────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  FIELD_OFFICER
  CASE_MANAGER
  VOLUNTEER_COORDINATOR
  FINANCE_OFFICER
}

enum StaffDepartment {
  FIELD_OPERATIONS
  CASE_MANAGEMENT
  HEALTH_SERVICES
  EDUCATION
  LOGISTICS_RELIEF
  FINANCE_ADMIN
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum VolunteerStatus {
  APPLIED
  INTERVIEWED
  ACTIVE
  INACTIVE
  REJECTED
}

enum VolunteerAvailability {
  WEEKDAYS
  WEEKENDS
  EVENINGS
  FULL_TIME
  ON_CALL
}

// ─── Staff Models ─────────────────────────────────────────────────────────────

model Staff {
  id               String          @id @default(cuid())
  employeeId       String          @unique
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String          @unique
  phone            String?
  designation      String
  role             StaffRole       @default(FIELD_OFFICER)
  department       StaffDepartment @default(FIELD_OPERATIONS)
  status           StaffStatus     @default(ACTIVE)
  permissions      String[]
  joinedAt         DateTime        @default(now())
  emergencyContact String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedCases        CaseAssignment[]
  activities           StaffActivity[]
  reviewedApplications WelfareApplication[]

  @@map("staff")
}

model StaffCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("staff_code_sequence")
}

model CaseAssignment {
  id         String          @id @default(cuid())
  staffId    String
  staff      Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  caseId     String
  caseItem   BeneficiaryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  roleInCase String          @default("Primary Officer")
  assignedAt DateTime        @default(now())
  status     String          @default("ACTIVE")
  notes      String?

  @@map("case_assignment")
}

model StaffActivity {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action      String
  description String?
  targetType  String?
  targetId    String?
  performedAt DateTime @default(now())

  @@map("staff_activity")
}

// ─── Volunteer Models ─────────────────────────────────────────────────────────

model Volunteer {
  id               String                @id @default(cuid())
  volunteerCode    String                @unique
  cnic             String?               @unique
  name             String
  email            String
  phone            String
  status           VolunteerStatus       @default(APPLIED)
  skills           String[]
  availability     VolunteerAvailability @default(WEEKENDS)
  city             String?
  district         String?
  area             String?
  address          String?
  totalHoursLogged Int                   @default(0)
  rating           Decimal?              @db.Decimal(3, 2)
  joinedAt         DateTime              @default(now())
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignAssignments VolunteerCampaignAssignment[]
  activities          VolunteerActivity[]

  @@map("volunteer")
}

model VolunteerCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("volunteer_code_sequence")
}

model WelfareCampaign {
  id                  String    @id @default(cuid())
  code                String    @unique
  title               String
  description         String?
  location            String?
  startDate           DateTime
  endDate             DateTime?
  status              String    @default("PLANNING")
  targetBeneficiaries Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  volunteerAssignments VolunteerCampaignAssignment[]

  @@map("welfare_campaign")
}

model CampaignCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("campaign_code_sequence")
}

model VolunteerCampaignAssignment {
  id          String          @id @default(cuid())
  volunteerId String
  volunteer   Volunteer       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    WelfareCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  role        String?
  assignedAt  DateTime        @default(now())
  hoursLogged Int             @default(0)
  status      String          @default("ASSIGNED")

  @@map("volunteer_campaign_assignment")
}

model VolunteerActivity {
  id           String    @id @default(cuid())
  volunteerId  String
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  hours        Int       @default(0)
  activityDate DateTime  @default(now())
  location     String?
  feedback     String?
  createdAt    DateTime  @default(now())

  @@map("volunteer_activity")
}

// ─── Welfare Program Models ────────────────────────────────────────────────────

model WelfareProgram {
  id                  String             @id @default(cuid())
  code                String             @unique
  name                String
  slug                String             @unique
  description         String?            @db.Text
  eligibilityCriteria String?            @db.Text
  budget              Decimal            @default(0) @db.Decimal(14, 2)
  spentBudget         Decimal            @default(0) @db.Decimal(14, 2)
  startDate           DateTime
  endDate             DateTime?
  status              ProgramStatus      @default(ACTIVE)
  assistanceType      AssistanceType     @default(FINANCIAL)
  requiredDocuments   DocumentType[]
  targetBeneficiaries Int?
  maxBeneficiaries    Int?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  enrollments         ProgramEnrollment[]
  disbursements       AssistanceRecord[]
  applications        WelfareApplication[]

  @@map("welfare_program")
}

model ProgramCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("program_code_sequence")
}

model ProgramEnrollment {
  id            String         @id @default(cuid())
  programId     String
  program       WelfareProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  status        String         @default("ENROLLED")
  enrolledAt    DateTime       @default(now())
  approvedAt    DateTime?
  notes         String?

  @@unique([programId, beneficiaryId])
  @@map("program_enrollment")
}

// ─── Welfare Application Models ───────────────────────────────────────────────

model WelfareApplication {
  id              String              @id @default(cuid())
  applicationCode String              @unique
  beneficiaryId   String
  beneficiary     Beneficiary         @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  programId       String?
  program         WelfareProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)

  assistanceType  AssistanceType      @default(FINANCIAL)
  requestedAmount Decimal?            @db.Decimal(12, 2)
  requestedItems  String?
  reason          String              @db.Text

  priority        ApplicationPriority @default(MEDIUM)
  status          ApplicationStatus   @default(SUBMITTED)
  documents       String[]

  reviewerId      String?
  reviewer        Staff?              @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNotes     String?             @db.Text
  rejectionReason String?             @db.Text

  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?
  verifiedAt      DateTime?
  assessedAt      DateTime?
  decidedAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  logs            ApplicationLog[]

  @@map("welfare_application")
}

model ApplicationCodeSequence {
  year      Int @id
  nextValue Int @default(0)

  @@map("application_code_sequence")
}

model ApplicationLog {
  id            String              @id @default(cuid())
  applicationId String
  application   WelfareApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  notes         String?
  performedBy   String?
  timestamp     DateTime            @default(now())

  @@map("application_log")
}


